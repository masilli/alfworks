---
import { ArrowUpRight, Menu, X } from 'lucide-astro';
import { type Lang, ui, defaultLang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const t = ui[lang].nav;

const homeHref = lang === 'pt' ? '/' : '/en';

const navItems = [
  { label: t.consulting, href: t.consultingHref },
  { label: t.ventureLab, href: t.ventureLabHref },
  { label: t.about, href: t.aboutHref },
  { label: t.contact, href: t.contactHref },
];
---

<header class="sticky top-0 z-50 w-full bg-[#F9F9FB]/95 backdrop-blur-sm border-b border-zinc-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">
      
      <!-- Monospaced / Bold Brand Mark -->
      <a
        href={homeHref}
        class="group flex items-center gap-2.5 font-mono font-bold text-base sm:text-lg tracking-wider text-[#111111] transition-colors"
      >
        <span class="inline-block w-2.5 h-2.5 bg-[#E11D48] transition-transform group-hover:scale-110"></span>
        <span>ALF WORKS</span>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-8">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class="text-sm font-medium text-[#666666] hover:text-[#111111] transition-colors relative py-1 after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[2px] after:bg-[#111111] hover:after:w-full after:transition-all"
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <!-- Language Switcher & High-Contrast CTA Button & Mobile Toggle -->
      <div class="flex items-center gap-3 sm:gap-4">
        
        <!-- Swiss Minimalist Language Switcher -->
        <div class="inline-flex items-center border border-zinc-200 bg-white text-xs font-mono">
          <a
            href="/"
            class={`px-2 py-1 transition-colors ${
              lang === 'pt'
                ? 'bg-[#111111] text-[#F9F9FB] font-bold'
                : 'text-[#666666] hover:text-[#111111] hover:bg-zinc-50'
            }`}
            aria-label="Mudar para Português"
            aria-current={lang === 'pt' ? 'true' : 'false'}
          >
            PT
          </a>
          <span class="w-px h-3 bg-zinc-200"></span>
          <a
            href="/en"
            class={`px-2 py-1 transition-colors ${
              lang === 'en'
                ? 'bg-[#111111] text-[#F9F9FB] font-bold'
                : 'text-[#666666] hover:text-[#111111] hover:bg-zinc-50'
            }`}
            aria-label="Switch to English"
            aria-current={lang === 'en' ? 'true' : 'false'}
          >
            EN
          </a>
        </div>

        <!-- High-Contrast CTA Button -->
        <a
          href={t.contactHref}
          class="hidden sm:inline-flex items-center gap-1.5 px-4 py-2 bg-[#111111] text-[#F9F9FB] text-xs font-semibold uppercase tracking-wider hover:bg-[#E11D48] transition-colors duration-150"
        >
          <span>{t.cta}</span>
          <ArrowUpRight class="w-3.5 h-3.5" />
        </a>

        <!-- Mobile Menu Button -->
        <button
          id="mobile-menu-toggle"
          type="button"
          aria-label={lang === 'pt' ? 'Abrir menu' : 'Open menu'}
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="md:hidden p-2 text-[#111111] hover:text-[#E11D48] transition-colors focus:outline-none"
        >
          <Menu id="menu-icon-open" class="w-6 h-6 block" />
          <X id="menu-icon-close" class="w-6 h-6 hidden" />
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-zinc-200 bg-[#F9F9FB] px-4 pt-4 pb-6 space-y-3"
  >
    <div class="flex flex-col space-y-3">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="mobile-nav-link text-base font-medium text-[#666666] hover:text-[#111111] py-2 border-b border-zinc-100 transition-colors"
          >
            {item.label}
          </a>
        ))
      }
      
      <!-- Mobile Language Switcher Row -->
      <div class="pt-2 flex items-center justify-between border-b border-zinc-100 pb-3">
        <span class="text-xs font-mono text-[#666666] uppercase">Idioma / Language:</span>
        <div class="inline-flex items-center border border-zinc-200 bg-white text-xs font-mono">
          <a
            href="/"
            class={`px-2.5 py-1 ${
              lang === 'pt'
                ? 'bg-[#111111] text-white font-bold'
                : 'text-[#666666]'
            }`}
          >
            PT
          </a>
          <span class="w-px h-3 bg-zinc-200"></span>
          <a
            href="/en"
            class={`px-2.5 py-1 ${
              lang === 'en'
                ? 'bg-[#111111] text-white font-bold'
                : 'text-[#666666]'
            }`}
          >
            EN
          </a>
        </div>
      </div>

      <div class="pt-2">
        <a
          href={t.contactHref}
          class="mobile-nav-link flex items-center justify-center gap-2 w-full px-4 py-3 bg-[#111111] text-[#F9F9FB] text-sm font-semibold uppercase tracking-wider hover:bg-[#E11D48] transition-colors"
        >
          <span>{t.cta}</span>
          <ArrowUpRight class="w-4 h-4" />
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  if (toggleBtn && mobileMenu && iconOpen && iconClose) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      mobileMenu.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });

    mobileLinks.forEach((link) => {
      link.addEventListener('click', () => {
        toggleBtn.setAttribute('aria-expanded', 'false');
        mobileMenu.classList.add('hidden');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
      });
    });
  }
</script>
