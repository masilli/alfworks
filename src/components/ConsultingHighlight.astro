---
import { ArrowRight, BarChart3, Bot, CalendarCheck, Globe, Layers } from 'lucide-astro';
import { type Lang, ui, defaultLang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const t = ui[lang].consulting;

const contactHref = lang === 'pt' ? '#contacto' : '#contact';

const iconMap = [Layers, BarChart3, Globe, Bot];
---

<!-- Section Container with dual ID support (#consultoria & #consulting) -->
<section id="consultoria" class="border-b border-zinc-200 bg-white py-20 sm:py-28 relative">
  <!-- Anchor alias for English navigation -->
  <div id="consulting" class="absolute -top-20"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header (Swiss Asymmetric) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-16 pb-12 border-b border-zinc-200 items-end">
      <div class="lg:col-span-8 space-y-5">
        <!-- Technical Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-[#F9F9FB] border border-zinc-200 text-xs font-mono font-bold uppercase tracking-wider text-[#111111]">
          <span class="w-2 h-2 bg-[#E11D48]"></span>
          {t.badge}
        </div>

        <!-- Main Headline -->
        <h2 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tighter text-[#111111] leading-[1.06]">
          {t.headline}
        </h2>

        <!-- Subhead -->
        <p class="text-base sm:text-lg text-[#666666] max-w-3xl leading-relaxed">
          {t.subhead}
        </p>
      </div>

      <div class="lg:col-span-4 lg:text-right">
        <div class="inline-block p-5 border border-zinc-200 bg-[#F9F9FB] text-left text-xs font-mono text-[#666666] space-y-1.5">
          <div class="font-bold text-[#111111]">{t.philosophyTitle}</div>
          <div>{t.philosophyFlow}</div>
          <div class="text-[#E11D48] pt-1 font-semibold">{t.philosophySub}</div>
        </div>
      </div>
    </div>

    <!-- The Flagship Product Banner (Intervenção 7 Dias / 7-Day Sprint) -->
    <div class="mb-16 border border-zinc-200 bg-[#F9F9FB] p-8 sm:p-12 relative overflow-hidden">
      <!-- Left Swiss Red Accent Line -->
      <div class="absolute left-0 top-0 bottom-0 w-1.5 bg-[#E11D48]"></div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-8 space-y-4">
          <div class="flex flex-wrap items-center gap-3">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-mono font-bold uppercase tracking-wider bg-white border border-zinc-200 text-[#E11D48]">
              <CalendarCheck class="w-3.5 h-3.5" />
              {t.sprintBadge}
            </span>
            <span class="text-xs font-mono text-[#666666] uppercase tracking-wider">
              {t.sprintType}
            </span>
          </div>

          <div>
            <h3 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[#111111]">
              {t.sprintTitle}
            </h3>
            <p class="text-xs sm:text-sm font-mono text-[#666666] mt-1">
              {t.sprintSub}
            </p>
          </div>

          <p class="text-sm sm:text-base text-[#666666] max-w-2xl leading-relaxed">
            {t.sprintDesc}
          </p>
        </div>

        <div class="lg:col-span-4 lg:text-right flex flex-col sm:flex-row lg:flex-col items-start lg:items-end justify-start lg:justify-center gap-3">
          <a
            href={contactHref}
            class="group inline-flex items-center justify-center gap-2.5 px-7 py-4 bg-[#111111] text-[#F9F9FB] text-xs font-semibold uppercase tracking-wider hover:bg-[#E11D48] transition-colors duration-150 w-full sm:w-auto text-center"
          >
            <span>{t.sprintCta}</span>
            <ArrowRight class="w-4 h-4 transition-transform group-hover:translate-x-1" />
          </a>
          <span class="text-[11px] font-mono text-[#666666]">
            {t.sprintSpots}
          </span>
        </div>
      </div>
    </div>

    <!-- The 4-Pillar Modular Grid (Swiss 2x2 Grid with 1px zinc borders) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-zinc-200 border border-zinc-200">
      {
        t.pillars.map((pillar, index) => {
          const Icon = iconMap[index] ?? Layers;
          return (
            <div class="bg-white p-8 sm:p-12 flex flex-col justify-between space-y-8 hover:bg-zinc-50/60 transition-colors">
              <div class="space-y-6">
                <!-- Card Header: Monospaced Number & Icon Container -->
                <div class="flex items-center justify-between border-b border-zinc-100 pb-5">
                  <div class="flex items-baseline gap-2">
                    <span class="font-mono text-2xl sm:text-3xl font-black text-[#111111] tracking-tight">
                      {pillar.number}
                    </span>
                    <span class="text-xs font-mono text-[#666666] tracking-wider">/ 04</span>
                  </div>
                  <div class="w-10 h-10 flex items-center justify-center border border-zinc-200 bg-[#F9F9FB] text-[#111111]">
                    <Icon class="w-4 h-4" />
                  </div>
                </div>

                <!-- Title & Core Concept -->
                <div class="space-y-3">
                  <h3 class="text-2xl font-bold tracking-tight text-[#111111]">
                    {pillar.title}
                  </h3>
                  <p class="text-sm sm:text-base text-[#666666] leading-relaxed">
                    {pillar.description}
                  </p>
                </div>

                <!-- Scope Sub-points -->
                <ul class="pt-4 space-y-2.5 border-t border-zinc-100 text-xs text-[#111111]">
                  {pillar.subpoints.map((point) => (
                    <li class="flex items-start gap-2.5">
                      <span class="w-1.5 h-1.5 bg-[#E11D48] mt-1.5 flex-shrink-0" />
                      <span class="leading-normal">{point}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Modular Card Footer -->
              <div class="pt-6 border-t border-zinc-100 flex items-center justify-between text-[11px] font-mono text-[#666666]">
                <span>PILAR {pillar.number}</span>
                <span class="text-[#111111] font-semibold">{t.pillarFooter}</span>
              </div>
            </div>
          );
        })
      }
    </div>

  </div>
</section>
