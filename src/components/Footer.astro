---
import { ArrowUp, ArrowUpRight, Mail } from 'lucide-astro';
import { type Lang, ui, defaultLang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const t = ui[lang].footer;
---

<footer class="border-t border-zinc-200 bg-white py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6 text-xs font-mono text-[#666666]">
      
      <!-- Brand & Direct Email Link -->
      <div class="flex flex-wrap items-center gap-3 text-center md:text-left">
        <span class="inline-block w-2.5 h-2.5 bg-[#E11D48]"></span>
        <span class="font-bold text-[#111111] tracking-wider">ALF WORKS</span>
        <span class="text-zinc-300">|</span>
        <span>{t.copyright}</span>
        <span class="text-zinc-300">|</span>
        <a
          href={`mailto:${t.email}`}
          class="text-[#111111] hover:text-[#E11D48] transition-colors underline decoration-zinc-300 underline-offset-4"
        >
          {t.email}
        </a>
      </div>

      <!-- Operational Base Notice -->
      <div class="text-center">
        <span class="text-zinc-400">{t.baseNoticePrefix}</span>
        <span class="text-[#111111] font-semibold">{t.baseNotice}</span>
      </div>

      <!-- Social & Back to Top Anchor -->
      <div class="flex items-center gap-5">
        <a
          href={t.linkedinHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 text-[#666666] hover:text-[#111111] transition-colors"
        >
          <span>{t.linkedin}</span>
          <ArrowUpRight class="w-3 h-3" />
        </a>

        <a
          href="#"
          aria-label={t.backToTop}
          class="group inline-flex items-center gap-1.5 px-3 py-1.5 border border-zinc-200 hover:border-[#111111] hover:text-[#111111] text-[#666666] transition-colors"
        >
          <span>{t.backToTop}</span>
          <ArrowUp class="w-3.5 h-3.5 transition-transform group-hover:-translate-y-0.5" />
        </a>
      </div>

    </div>
  </div>
</footer>
