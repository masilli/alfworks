---
// src/components/Contact.astro
---

<section id="contacto" class="py-24 border-t border-zinc-200 bg-[#F9F9FB]">
  <div class="max-w-4xl mx-auto px-6">
    <div class="mb-12">
      <span class="text-xs font-mono tracking-widest text-[#E11D48] uppercase">[Diagnóstico & Intervenção]</span>
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#111111] mt-2">
        Vamos desbloquear o crescimento do seu negócio?
      </h2>
      <p class="text-zinc-600 mt-4 text-base">
        Preencha o formulário. Analisamos os estrangulamentos da sua operação e respondemos em 24 a 48 horas úteis.
      </p>
    </div>

    <!-- Formulário Netlify Forms -->
    <form
      name="contacto-alfworks"
      method="POST"
      data-netlify="true"
      data-netlify-honeypot="bot-field"
      action="/sucesso"
      class="space-y-6"
    >
      <!-- Identificador do formulário para o bot de build da Netlify -->
      <input type="hidden" name="form-name" value="contacto-alfworks" />

      <!-- Proteção anti-spam invisível (Honeypot) -->
      <p class="hidden">
        <label>Não preencha este campo se for humano: <input name="bot-field" /></label>
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label for="nome" class="block text-xs font-mono uppercase tracking-wider text-zinc-700 mb-2">O seu Nome *</label>
          <input
            type="text"
            id="nome"
            name="nome"
            required
            placeholder="ex: João Silva"
            class="w-full px-4 py-3 bg-white border border-zinc-300 rounded-none focus:outline-none focus:border-zinc-900 transition-colors text-sm"
          />
        </div>

        <div>
          <label for="email" class="block text-xs font-mono uppercase tracking-wider text-zinc-700 mb-2">E-mail de Contacto *</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            placeholder="ex: joao@empresa.pt"
            class="w-full px-4 py-3 bg-white border border-zinc-300 rounded-none focus:outline-none focus:border-zinc-900 transition-colors text-sm"
          />
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label for="empresa" class="block text-xs font-mono uppercase tracking-wider text-zinc-700 mb-2">Nome da Empresa / Website</label>
          <input
            type="text"
            id="empresa"
            name="empresa"
            placeholder="ex: Minha Empresa Lda / site.pt"
            class="w-full px-4 py-3 bg-white border border-zinc-300 rounded-none focus:outline-none focus:border-zinc-900 transition-colors text-sm"
          />
        </div>

        <div>
          <label for="area" class="block text-xs font-mono uppercase tracking-wider text-zinc-700 mb-2">Principal Área de Interesse *</label>
          <select
            id="area"
            name="area"
            required
            class="w-full px-4 py-3 bg-white border border-zinc-300 rounded-none focus:outline-none focus:border-zinc-900 transition-colors text-sm"
          >
            <option value="" disabled selected>Selecione uma opção</option>
            <option value="intervencao-pme">Intervenção Rápida PME (Diagnóstico 7 Dias)</option>
            <option value="operacoes">Otimização Operacional & Processos</option>
            <option value="financas">Controlo Financeiro, Margens & Dashboards</option>
            <option value="digital-vendas">Presença Digital & Máquina de Aquisição</option>
            <option value="automacao-ia">Automação, Integrações & IA</option>
            <option value="grandes-ativos">Grandes Ativos & Soluções Corporativas</option>
            <option value="outro">Outro assunto</option>
          </select>
        </div>
      </div>

      <div>
        <label for="mensagem" class="block text-xs font-mono uppercase tracking-wider text-zinc-700 mb-2">Resumo do Desafio / Gargalo Atual *</label>
        <textarea
          id="mensagem"
          name="mensagem"
          rows="4"
          required
          placeholder="Onde é que a empresa está a perder mais tempo, dinheiro ou clientes atualmente?"
          class="w-full px-4 py-3 bg-white border border-zinc-300 rounded-none focus:outline-none focus:border-zinc-900 transition-colors text-sm resize-y"
        ></textarea>
      </div>

      <div>
        <button
          type="submit"
          class="w-full md:w-auto px-8 py-4 bg-[#111111] text-white hover:bg-[#E11D48] font-medium text-sm tracking-wide uppercase transition-colors cursor-pointer"
        >
          Enviar Pedido de Diagnóstico &rarr;
        </button>
      </div>
    </form>
  </div>
</section>
