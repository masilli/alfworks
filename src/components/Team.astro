---
import { ArrowRight, Briefcase, Building2, Code, Compass } from 'lucide-astro';
import { type Lang, ui, defaultLang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const tCorp = ui[lang].corporate;
const tTeam = ui[lang].team;

const contactHref = lang === 'pt' ? '#contacto' : '#contact';

const icons = [Briefcase, Compass, Code];
---

<!-- Section Container with dual ID support (#sobre & #about) -->
<section id="sobre" class="border-b border-zinc-200 bg-white py-20 sm:py-28 relative">
  <!-- Anchor alias for English navigation -->
  <div id="about" class="absolute -top-20"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Corporate & Large Assets Module (Discreet High-Authority Block) -->
    <div class="mb-20 border border-zinc-200 bg-[#F9F9FB] p-8 sm:p-12 relative overflow-hidden">
      <!-- Left High-Contrast Accent Strip -->
      <div class="absolute left-0 top-0 bottom-0 w-1.5 bg-[#111111]"></div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center pl-2 sm:pl-4">
        <div class="lg:col-span-8 space-y-4">
          <div class="inline-flex items-center gap-2 text-xs font-mono font-bold uppercase tracking-wider text-[#111111]">
            <Building2 class="w-3.5 h-3.5 text-[#E11D48]" />
            <span>{tCorp.badge}</span>
          </div>

          <h3 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-[#111111]">
            {tCorp.title}
          </h3>

          <p class="text-sm sm:text-base text-[#666666] leading-relaxed max-w-3xl">
            {tCorp.desc}
          </p>

          <!-- 3 Micro-pills of Enterprise Competencies -->
          <div class="flex flex-wrap gap-2 pt-2">
            {
              tCorp.pills.map((pill) => (
                <span class="px-2.5 py-1 bg-white border border-zinc-200 text-xs font-mono text-[#111111]">
                  {pill}
                </span>
              ))
            }
          </div>
        </div>

        <div class="lg:col-span-4 lg:text-right flex flex-col sm:flex-row lg:flex-col items-start lg:items-end justify-start lg:justify-center gap-3">
          <a
            href={contactHref}
            class="group inline-flex items-center justify-center gap-2.5 px-6 py-3.5 bg-[#111111] text-[#F9F9FB] text-xs font-semibold uppercase tracking-wider hover:bg-[#E11D48] transition-colors duration-150 w-full sm:w-auto text-center"
          >
            <span>{tCorp.cta}</span>
            <ArrowRight class="w-4 h-4 transition-transform group-hover:translate-x-1" />
          </a>
          <span class="text-[11px] font-mono text-[#666666]">
            {tCorp.sub}
          </span>
        </div>
      </div>
    </div>

    <!-- Section Header (Swiss Asymmetric) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-16 pb-10 border-b border-zinc-200 items-end">
      <div class="lg:col-span-8 space-y-4">
        <div class="inline-flex items-center gap-2 text-xs font-mono font-bold text-[#E11D48] uppercase tracking-widest">
          <span class="w-2 h-2 bg-[#E11D48]"></span>
          {tTeam.badge}
        </div>
        <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tighter text-[#111111] leading-tight">
          {tTeam.title}
        </h2>
        <p class="text-base sm:text-lg text-[#666666] max-w-3xl leading-relaxed">
          {tTeam.desc}
        </p>
      </div>

      <div class="lg:col-span-4 lg:text-right">
        <div class="inline-block p-4 border border-zinc-200 bg-[#F9F9FB] text-left text-xs font-mono text-[#666666] space-y-1">
          <div class="font-bold text-[#111111]">{tTeam.structureBadge}</div>
          <div>{tTeam.structureTitle}</div>
          <div class="text-[#E11D48] pt-1 font-semibold">{tTeam.structureSub}</div>
        </div>
      </div>
    </div>

    <!-- 3-Column Clean Biographical Layout (1px divider grid) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-zinc-200 border border-zinc-200">
      {
        tTeam.founders.map((founder, idx) => {
          const Icon = icons[idx] ?? Briefcase;
          return (
            <div class="bg-white p-8 sm:p-10 flex flex-col justify-between space-y-8 hover:bg-zinc-50/50 transition-colors">
              <div class="space-y-6">
                <!-- Large Monospaced Initial Letter & Pillar -->
                <div class="flex items-center justify-between border-b border-zinc-100 pb-4">
                  <div class="flex items-baseline gap-3">
                    <span class="font-mono text-4xl sm:text-5xl font-black text-[#111111] tracking-tighter">
                      {founder.initial}
                    </span>
                    <span class="text-xs font-mono text-[#E11D48] font-bold uppercase tracking-wider">
                      / {founder.name}
                    </span>
                  </div>
                  <div class="w-8 h-8 flex items-center justify-center border border-zinc-200 bg-[#F9F9FB] text-[#111111]">
                    <Icon class="w-4 h-4" />
                  </div>
                </div>

                <!-- Name & Role -->
                <div class="space-y-2">
                  <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-[#111111]">
                    {founder.name}
                  </h3>
                  <p class="text-xs font-mono uppercase tracking-wider text-[#E11D48] font-semibold">
                    {founder.role}
                  </p>
                </div>

                <!-- Precision Biography -->
                <p class="text-sm text-[#666666] leading-relaxed">
                  {founder.bio}
                </p>

                <!-- Key Focus Competencies -->
                <div class="pt-4 border-t border-zinc-100 space-y-2">
                  <span class="text-[11px] font-mono text-[#666666] uppercase tracking-wider block">
                    {tTeam.focusLabel}
                  </span>
                  <ul class="space-y-1.5 text-xs text-[#111111]">
                    {founder.focus.map((item) => (
                      <li class="flex items-center gap-2">
                        <span class="w-1.5 h-1.5 bg-[#111111]" />
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <!-- Footer Indicator -->
              <div class="pt-6 border-t border-zinc-100 flex items-center justify-between text-[11px] font-mono text-[#666666]">
                <span>PILAR: {founder.pillar}</span>
                <span class="text-[#111111] font-semibold">{tTeam.partnerLabel}</span>
              </div>
            </div>
          );
        })
      }
    </div>

  </div>
</section>
