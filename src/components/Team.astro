---
import { ArrowRight, Briefcase, Building2, Code, Compass } from 'lucide-astro';
import { type Lang, ui, defaultLang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const tCorp = ui[lang].corporate;
const tTeam = ui[lang].team;

const contactHref = lang === 'pt' ? '#contacto' : '#contact';

const icons = [Briefcase, Compass, Code];

const founderPhotos = [
  {
    src: '/images/team/alfredo.jpg',
    alt: 'Alfredo — Estratégia Empresarial & Gestão Financeira',
  },
  {
    src: '/images/team/luisa.jpg',
    alt: 'Luísa — Marketing de Ativos, Ativação Comercial & Protocolo',
  },
  {
    src: '/images/team/filipe.jpg',
    alt: 'Filipe — Engenharia de Software, Sistemas & Automação',
  },
];
---

<!-- Section Container with dual ID support (#sobre & #about) -->
<section id="sobre" class="border-b border-zinc-200 bg-white py-20 sm:py-28 relative">
  <!-- Anchor alias for English navigation -->
  <div id="about" class="absolute -top-20"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Corporate & Large Assets Module (Inverted High-Contrast Dark Block) -->
    <div class="mb-24 border border-zinc-800 bg-[#111111] text-white p-8 sm:p-12 lg:p-14 relative overflow-hidden">
      <!-- Left Swiss Red Accent Strip -->
      <div class="absolute left-0 top-0 bottom-0 w-1.5 bg-[#E11D48]"></div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center pl-2 sm:pl-4">
        <div class="lg:col-span-8 space-y-4">
          <div class="inline-flex items-center gap-2 text-xs font-mono font-bold uppercase tracking-wider text-[#E11D48]">
            <Building2 class="w-3.5 h-3.5 text-[#E11D48]" />
            <span>{tCorp.badge}</span>
          </div>

          <h3 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-white">
            {tCorp.title}
          </h3>

          <p class="text-sm sm:text-base text-zinc-400 leading-relaxed max-w-3xl">
            {tCorp.desc}
          </p>

          <!-- 3 Micro-pills of Enterprise Competencies -->
          <div class="flex flex-wrap gap-2 pt-2">
            {
              tCorp.pills.map((pill) => (
                <span class="px-3 py-1 bg-zinc-900 border border-zinc-700 text-xs font-mono text-zinc-200">
                  {pill}
                </span>
              ))
            }
          </div>
        </div>

        <div class="lg:col-span-4 lg:text-right flex flex-col sm:flex-row lg:flex-col items-start lg:items-end justify-start lg:justify-center gap-3">
          <a
            href={contactHref}
            class="group inline-flex items-center justify-center gap-2.5 px-6 py-4 bg-white text-[#111111] hover:bg-[#E11D48] hover:text-white text-xs font-semibold uppercase tracking-wider transition-colors duration-150 w-full sm:w-auto text-center cursor-pointer"
          >
            <span>{tCorp.cta}</span>
            <ArrowRight class="w-4 h-4 transition-transform group-hover:translate-x-1" />
          </a>
          <span class="text-[11px] font-mono text-zinc-500">
            {tCorp.sub}
          </span>
        </div>
      </div>

      <!-- Editorial Wide-Aspect Architectural Image Block honoring Swiss grid alignment -->
      <div class="mt-10 border border-zinc-800 overflow-hidden relative group">
        <div class="aspect-[21/9] sm:aspect-[24/9] w-full overflow-hidden bg-zinc-900">
          <img
            src="/images/corporate/architecture.jpg"
            alt="Grandes Ativos & Gestão Corporativa — Infraestrutura e Espaços Comerciais"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover object-center grayscale contrast-125 group-hover:grayscale-0 group-hover:contrast-100 transition-all duration-700 ease-out scale-100 group-hover:scale-105 opacity-90 group-hover:opacity-100"
          />
        </div>
        <!-- Subtle technical overlay bar -->
        <div class="absolute bottom-0 left-0 right-0 bg-[#111111]/95 backdrop-blur-xs px-4 py-2.5 flex items-center justify-between text-[11px] font-mono text-zinc-400 border-t border-zinc-800">
          <div class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 bg-[#E11D48]"></span>
            <span class="text-zinc-300">REF: CORP-INFRA // GESTÃO DE GRANDES ATIVOS & INFRAESTRUTURAS</span>
          </div>
          <span class="hidden sm:inline text-zinc-500">ALF WORKS ENTERPRISE</span>
        </div>
      </div>

    </div>

    <!-- Section Header (Swiss Asymmetric) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-16 pb-10 border-b border-zinc-200 items-end">
      <div class="lg:col-span-8 space-y-4">
        <div class="inline-flex items-center gap-2 text-xs font-mono font-bold text-[#E11D48] uppercase tracking-widest">
          <span class="w-2 h-2 bg-[#E11D48]"></span>
          {tTeam.badge}
        </div>
        <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tighter text-[#111111] leading-tight">
          {tTeam.title}
        </h2>
        <p class="text-base sm:text-lg text-[#666666] max-w-3xl leading-relaxed">
          {tTeam.desc}
        </p>
      </div>

      <div class="lg:col-span-4 lg:text-right">
        <div class="inline-block p-4 border border-zinc-200 bg-[#F9F9FB] text-left text-xs font-mono text-[#666666] space-y-1">
          <div class="font-bold text-[#111111]">{tTeam.structureBadge}</div>
          <div>{tTeam.structureTitle}</div>
          <div class="text-[#E11D48] pt-1 font-semibold">{tTeam.structureSub}</div>
        </div>
      </div>
    </div>

    <!-- 3-Column Clean Biographical Layout (1px divider grid) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-zinc-200 border border-zinc-200">
      {
        tTeam.founders.map((founder, idx) => {
          const Icon = icons[idx] ?? Briefcase;
          const photo = founderPhotos[idx];
          return (
            <div class="bg-white p-8 sm:p-10 flex flex-col justify-between space-y-8 hover:bg-zinc-50/50 transition-colors">
              <div class="space-y-6">
                
                <!-- Dedicated 1:1 Aspect Ratio Photo Container with 1px border and high-contrast grayscale -->
                <div class="relative aspect-square w-full border border-zinc-200 bg-zinc-100 overflow-hidden group/photo">
                  <img
                    src={photo.src}
                    alt={photo.alt}
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover object-top grayscale contrast-125 group-hover/photo:grayscale-0 group-hover/photo:contrast-100 transition-all duration-500 ease-out group-hover/photo:scale-105"
                  />
                  <!-- Monospaced Letter Overlay Badge -->
                  <div class="absolute top-0 left-0 bg-[#111111] text-white font-mono text-sm font-black px-2.5 py-1">
                    {founder.initial}
                  </div>
                </div>

                <!-- Large Monospaced Initial Letter & Pillar -->
                <div class="flex items-center justify-between border-b border-zinc-100 pb-4">
                  <div class="flex items-baseline gap-3">
                    <span class="font-mono text-3xl font-black text-[#111111] tracking-tight">
                      {founder.name}
                    </span>
                    <span class="text-xs font-mono text-[#E11D48] font-bold uppercase tracking-wider">
                      / {founder.pillar}
                    </span>
                  </div>
                  <div class="w-8 h-8 flex items-center justify-center border border-zinc-200 bg-[#F9F9FB] text-[#111111]">
                    <Icon class="w-4 h-4" />
                  </div>
                </div>

                <!-- Name & Role -->
                <div class="space-y-1.5">
                  <p class="text-xs font-mono uppercase tracking-wider text-[#E11D48] font-semibold">
                    {founder.role}
                  </p>
                </div>

                <!-- Precision Biography -->
                <p class="text-sm text-[#666666] leading-relaxed">
                  {founder.bio}
                </p>

                <!-- Key Focus Competencies -->
                <div class="pt-4 border-t border-zinc-100 space-y-2">
                  <span class="text-[11px] font-mono text-[#666666] uppercase tracking-wider block">
                    {tTeam.focusLabel}
                  </span>
                  <ul class="space-y-1.5 text-xs text-[#111111]">
                    {founder.focus.map((item) => (
                      <li class="flex items-center gap-2">
                        <span class="w-1.5 h-1.5 bg-[#111111]" />
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <!-- Footer Indicator -->
              <div class="pt-6 border-t border-zinc-100 flex items-center justify-between text-[11px] font-mono text-[#666666]">
                <span>PILAR: {founder.pillar}</span>
                <span class="text-[#111111] font-semibold">{tTeam.partnerLabel}</span>
              </div>
            </div>
          );
        })
      }
    </div>

  </div>
</section>
