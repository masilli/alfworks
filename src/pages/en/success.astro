---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { ArrowLeft, CheckCircle2 } from 'lucide-astro';
import { ui } from '../../i18n/ui';

const t = ui.en.success;
---

<Layout lang="en" title={t.metaTitle} description={t.metaDescription}>
  <Header lang="en" />

  <main class="flex-grow flex items-center justify-center py-24 sm:py-32 bg-[#F9F9FB]">
    <div class="max-w-2xl mx-auto px-6 text-center">
      <div class="border border-zinc-200 bg-white p-8 sm:p-14 space-y-6">
        <div class="inline-flex items-center justify-center w-12 h-12 border border-zinc-200 bg-[#F9F9FB] text-[#E11D48] mx-auto">
          <CheckCircle2 class="w-6 h-6" />
        </div>

        <div class="space-y-3">
          <span class="text-xs font-mono tracking-widest text-[#E11D48] uppercase">{t.badge}</span>
          <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[#111111]">
            {t.title}
          </h1>
          <p class="text-zinc-600 text-base leading-relaxed max-w-lg mx-auto">
            {t.desc}
          </p>
        </div>

        <div class="pt-6 border-t border-zinc-100 flex items-center justify-center">
          <a
            href="/en"
            class="inline-flex items-center gap-2 px-6 py-3.5 bg-[#111111] text-white hover:bg-[#E11D48] text-xs font-semibold uppercase tracking-wider transition-colors"
          >
            <ArrowLeft class="w-4 h-4" />
            <span>{t.backHome}</span>
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer lang="en" />
</Layout>
