---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import InteractiveCalculator from '../../components/InteractiveCalculator.astro';
import ConsultingHighlight from '../../components/ConsultingHighlight.astro';
import VentureLab from '../../components/VentureLab.astro';
import Team from '../../components/Team.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';
---

<Layout lang="en">
  <Header lang="en" />

  <main class="flex-grow">
    <!-- Hero Section -->
    <Hero lang="en" />

    <!-- Interactive SME Friction & Waste Calculator -->
    <InteractiveCalculator lang="en" />

    <!-- Primary Spotlight: Consulting Section (#consulting) -->
    <ConsultingHighlight lang="en" />

    <!-- Venture Lab & Studio Verticals (#venture-lab) -->
    <VentureLab lang="en" />

    <!-- Team & Studio Identity (#about) -->
    <Team lang="en" />

    <!-- Contact & Diagnostic Request (#contact) -->
    <Contact lang="en" />
  </main>

  <!-- Site Footer -->
  <Footer lang="en" />
</Layout>
