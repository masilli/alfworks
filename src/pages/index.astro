---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ConsultingHighlight from '../components/ConsultingHighlight.astro';
import VentureLab from '../components/VentureLab.astro';
import Team from '../components/Team.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Layout lang="pt">
  <Header lang="pt" />

  <main class="flex-grow">
    <!-- Hero Section -->
    <Hero lang="pt" />

    <!-- Primary Spotlight: Consulting Section (#consultoria) -->
    <ConsultingHighlight lang="pt" />

    <!-- Venture Lab & Studio Verticals (#venture-lab) -->
    <VentureLab lang="pt" />

    <!-- Team & Studio Identity (#sobre) -->
    <Team lang="pt" />

    <!-- Contact & Diagnostic Request (#contacto) -->
    <Contact lang="pt" />
  </main>

  <!-- Site Footer -->
  <Footer lang="pt" />
</Layout>
